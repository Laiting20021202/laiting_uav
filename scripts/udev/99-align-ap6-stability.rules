# Only this AP6. Applied again after boot or USB re-enumeration.
# Keep the device awake without resetting it or changing any parent hub.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2a58", ATTR{idProduct}=="a002", ATTR{serial}=="330032000D51333331333534", ENV{ID_MM_DEVICE_IGNORE}="1", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2a58", ATTR{idProduct}=="a002", ATTR{serial}=="330032000D51333331333534", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"
# Consistent serial permissions and no modem probing; tty numbers may change.
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="2a58", ATTRS{idProduct}=="a002", ATTRS{serial}=="330032000D51333331333534", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1", GROUP="dialout", MODE="0660"
