{
  "source_socket": "/source/source.sock",
  "data_dir": "/data",
  "control_socket": "/control/http.sock",
  "web_host": "0.0.0.0",
  "web_port": 8090,
  "min_free_mb": 2048,
  "max_recording_gb": 4,
  "max_recording_seconds": 1800,
  "camera_poll_hz": 4,
  "gps_ellipsoid_confirmed": false,
  "imu_source": "SCALED_IMU",
  "mag_source": "SCALED_IMU",
  "pressure_source": "SCALED_PRESSURE",
