    "/uav/imu/data_raw": {"expected_hz": 20, "timeout_s": 2},
    "/uav/attitude": {"expected_hz": 20, "timeout_s": 2},
    "/uav/gps/fix": {"expected_hz": 5, "timeout_s": 3},
    "/uav/altitude/relative_home": {"expected_hz": 10, "timeout_s": 2},
    "/uav/altitude/msl": {"expected_hz": 10, "timeout_s": 2},
    "/uav/velocity/enu": {"expected_hz": 10, "timeout_s": 2},
    "/uav/battery/state": {"expected_hz": 2, "timeout_s": 5},
    "/uav/imu/mag": {"expected_hz": 20, "timeout_s": 2},
    "/uav/barometer/pressure": {"expected_hz": 5, "timeout_s": 3}
  }
